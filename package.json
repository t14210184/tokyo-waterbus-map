    "audit:release": "node -e \"import('./scripts/audit-release.js')\"",
    "audit:metadata": "node -e \"import('./scripts/audit-release-metadata.js')\"",
    "audit:tile-network": "node -e \"import('./scripts/audit-tile-network.js')\"",
    "audit:tile-decode": "node -e \"import('./scripts/audit-tile-image-decode.js')\"",
    "audit:basemap-contract": "node -e \"import('./scripts/audit-basemap-contract.js')\"",
    "audit:geography": "node -e \"import('./scripts/audit-route-geography.js')\"",
    "audit:simulation": "node -e \"import('./scripts/audit-simulation-waterway.js')\"",
    "audit:focus": "node -e \"import('./scripts/audit-route-focus-safe-zone.js')\"",
