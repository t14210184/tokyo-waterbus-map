    "audit:water-land-dataset": "node -e \"import('./scripts/audit-water-land-dataset.js')\"",
    "audit:route-intersection-triage": "node -e \"import('./scripts/audit-route-intersection-triage.js')\"",
    "build:human-geographic-review-package": "node -e \"import('./scripts/build-human-geographic-review-package.js')\"",
    "audit:human-geographic-review-package": "node -e \"import('./scripts/audit-human-geographic-review-package.js')\"",
    "audit:review-package-reconciliation": "node -e \"import('./scripts/audit-review-package-reconciliation.js')\"",
