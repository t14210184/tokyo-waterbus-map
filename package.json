    "prepare:validation-dataset": "node -e \"import('./scripts/prepare-water-land-validation.js')\"",
    "test:nojs": "node -e \"import('./scripts/test-nojs-fallback.js')\"",
    "capture:release": "node -e \"import('./scripts/capture-release.js')\"",
